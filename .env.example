# Obrigatória — habilita os recursos de IA (chat, insights, Cérebro Corporativo, propostas).
# Sem ela, o app funciona mas as respostas geradas por IA degradam graciosamente.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Opcional — modelo usado pelo Cérebro Corporativo e pela geração de propostas.
# Padrão: claude-haiku-4-5-20251001. Ex.: claude-sonnet-4-6 para textos mais elaborados.
# CORPORATE_MODEL=claude-haiku-4-5-20251001
